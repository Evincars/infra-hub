# Copy to .env.local to override. Only VITE_* vars are exposed to the browser bundle.

# Base path of the REST API as seen by the browser (default: /api/v1, served via the dev proxy).
# VITE_API_BASE_URL=/api/v1

# Where the Vite dev server proxies /api requests (dev only, not bundled).
# VITE_API_PROXY_TARGET=http://localhost:8080
